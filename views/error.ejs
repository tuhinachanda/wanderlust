<% layout("/layouts/boilerplate") %>

<div class="container py-5 my-5">
  <div class="row justify-content-center">
    <div class="col-md-7 text-center">
      <div class="card border rounded-4 shadow-sm p-5">
        <div class="text-danger mb-3">
          <i class="fa-solid fa-triangle-exclamation fa-3x"></i>
        </div>
        <h2 class="fw-bold mb-2"><%= statusCode %> Error</h2>
        <p class="text-secondary fs-5 mb-4"><%= message %></p>
        <div>
          <a href="/listings" class="btn btn-danger rounded-pill px-4 py-2 fw-semibold me-2">
            <i class="fa-solid fa-house me-1"></i> Back to Home
          </a>
          <button onclick="window.history.back();" class="btn btn-outline-secondary rounded-pill px-4 py-2">
            Go Back
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
